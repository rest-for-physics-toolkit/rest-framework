# ---------------------------------------------------------------------------
# Version of the code (script mode, run at each build by the target
# rest_version): writes OUTPUT (RestVersionInfo.h, included only by
# source/tools/src/TRestVersion.cxx) with the version, the commit of the build
# and whether the tree was clean. The file is only rewritten if it changes, so
# only TRestVersion.cxx is compiled again after a commit.
#
# Inputs (-D): SOURCE_DIR (the git checkout), OUTPUT, VERSION (the VERSION of
# project(), e.g. 3.0.0), GIT_COMMIT (optional: the commit of a build without
# git, e.g. a release tarball or a Docker image, given with -DREST_GIT_COMMIT).
#
# Without git and without GIT_COMMIT the commit is "unknown" and the clean state
# unknown. A tag vX.Y.Z on the commit that differs from VERSION is a warning
# (the release tag and the VERSION of project() must agree).
# ---------------------------------------------------------------------------

set(_commit "unknown")
set(_describe "")
set(_date "")
set(_clean -1) # -1: unknown, 0: uncommitted changes, 1: clean

find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
  execute_process(
    COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE _head
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE _result
    ERROR_QUIET)
  if(_result EQUAL 0 AND _head)
    set(_commit ${_head})
    # Tracked files only: the local files not committed (ignored or untracked)
    # do not change the code
    execute_process(
      COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
      WORKING_DIRECTORY ${SOURCE_DIR}
      OUTPUT_VARIABLE _status
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_status STREQUAL "")
      set(_clean 1)
    else()
      set(_clean 0)
    endif()
    # The last tag and the commits since it (v2.3.1-5-gabc1234), or the
    # abbreviated commit without tags
    execute_process(
      COMMAND ${GIT_EXECUTABLE} describe --tags --always
      WORKING_DIRECTORY ${SOURCE_DIR}
      OUTPUT_VARIABLE _describe
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(
      COMMAND ${GIT_EXECUTABLE} log -1 --format=%ci
      WORKING_DIRECTORY ${SOURCE_DIR}
      OUTPUT_VARIABLE _date
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(
      COMMAND ${GIT_EXECUTABLE} describe --tags --exact-match
      WORKING_DIRECTORY ${SOURCE_DIR}
      OUTPUT_VARIABLE _tag
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_tag MATCHES "^v([0-9]+\\.[0-9]+\\.[0-9]+)$" AND NOT CMAKE_MATCH_1
                                                        STREQUAL VERSION)
      message(
        WARNING
          "The tag ${_tag} of the commit is not the VERSION of project() (${VERSION})"
      )
    endif()
  endif()
elseif(GIT_COMMIT)
  set(_commit ${GIT_COMMIT})
endif()

set(_content
    "// Generated by cmake/RestVersion.cmake at each build: do not edit
#define REST_VERSION_STRING \"${VERSION}\"
#define REST_GIT_COMMIT \"${_commit}\"
#define REST_GIT_DESCRIBE \"${_describe}\"
#define REST_GIT_DATE \"${_date}\"
#define REST_GIT_CLEAN ${_clean}
")

file(WRITE "${OUTPUT}.tmp" "${_content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp"
                        "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
